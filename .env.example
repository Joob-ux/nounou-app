# Serveur
NODE_ENV=development
PORT=4000

# Base de donnees
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nounou?schema=public"

# Auth
JWT_SECRET="change-moi-en-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# OTP
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Envoi des codes par WhatsApp (API Cloud de Meta). Laisser vide en local :
# le code s'affiche alors dans les logs du serveur.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="code_connexion"
WHATSAPP_TEMPLATE_LANG="fr"

# Commissions (pourcentages)
FRAIS_SERVICE_PCT=10
COMMISSION_PCT=10

# Agregateur de paiement (PayTech, PayDunya...)
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET="change-moi"

# Pieces justificatives (stockage local en dev, S3 chiffre plus tard)
UPLOAD_DIR="storage"
MAX_UPLOAD_MB=5
DEMO_MODE=false
